{
  "name": "opencode-subagent-watch",
  "version": "0.4.0",
  "description": "OpenCode TUI plugin for monitoring subagent activity",
  "keywords": [
    "opencode",
    "plugin",
    "subagent",
    "tui"
  ],
  "homepage": "https://github.com/darcien/opencode-subagent-watch#readme",
  "bugs": "https://github.com/darcien/opencode-subagent-watch/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darcien/opencode-subagent-watch.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:v2": "bun v2/scripts/build.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings --ignore-pattern 'v2/dist/**' .",
    "lint:fix": "oxlint --fix .",
    "test": "bun test",
    "demo": "bun run build && bun demo/provider.ts",
    "typecheck": "tsc --noEmit",
    "smoke:v2": "bun scripts/smoke-v2-package.ts",
    "precommit:lint": "bun run lint",
    "precommit:typecheck": "bun run typecheck",
    "precommit:test": "bun test --only-failures",
    "precommit": "bun run fmt && bun run --parallel --no-exit-on-error 'precommit:*'",
    "check": "bun run fmt:check && bun run --parallel --no-exit-on-error 'precommit:*' && bun run build && bun run build:v2 && bun scripts/smoke-package.ts && bun run smoke:v2"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.9",
    "@opencode-ai/sdk": "1.18.9",
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/bun": "1.3.14",
    "oxfmt": "0.61.0",
    "oxlint": "1.60.0",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.4.5",
    "solid-js": "1.9.12"
  }
}
